# Normalize text files to LF in the repo; scripts must stay LF to run on the Pi.
* text=auto eol=lf
*.sh  text eol=lf
*.py  text eol=lf
Makefile text eol=lf

# Binary media
*.mp4  binary
*.mov  binary
*.webm binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary

# Vendored, minified third-party code: no diffs, not counted in language stats
pi-mapper/web/js/maptastic.min.js -diff linguist-vendored
